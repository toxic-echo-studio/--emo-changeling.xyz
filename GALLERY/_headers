/*
  Link: </.well-known/ai-catalog.json>; rel="ai-catalog"; type="application/json"
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data: https://emo-changeling.xyz https://*.emo-changeling.xyz https://toxic-echo.studio https://*.toxic-echo.studio; connect-src 'self'; frame-src 'none'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self';
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/graphics/*.html
  X-Robots-Tag: noindex, follow
  Cache-Control: public, max-age=3600, must-revalidate
  Content-Type: text/html; charset=utf-8

/graphics/*/*/opis.html
  X-Robots-Tag: noindex, follow
  Cache-Control: public, max-age=3600, must-revalidate
  Content-Type: text/html; charset=utf-8

/fonts/*
  Cache-Control: public, max-age=31536000, immutable, no-transform

/js/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800, no-transform

/img/*
  Cache-Control: public, max-age=31536000, immutable, no-transform

/css/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800, no-transform

/sitemap.xml
  Cache-Control: public, max-age=3600, must-revalidate
  Content-Type: application/xml; charset=utf-8

/robots.txt
  Cache-Control: no-cache
  Content-Type: text/plain; charset=utf-8

/humans.txt
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Type: text/plain; charset=utf-8

/llms.txt
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Type: text/plain; charset=utf-8

/ai.txt
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Type: text/plain; charset=utf-8

/ai.json
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Type: application/json; charset=utf-8

/site.webmanifest
  Cache-Control: public, max-age=86400
  Content-Type: application/manifest+json; charset=utf-8

/favicon.svg
  Content-Type: image/svg+xml; charset=utf-8

/EmoChangeling.svg
  Content-Type: image/svg+xml; charset=utf-8

/.well-known/ai-catalog.json
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Type: application/json; charset=utf-8

/7f3a9d2b8e1c4f5a6b0d8e2c1f9a4b3d.txt
