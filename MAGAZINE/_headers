/*
  Link: </.well-known/ai-catalog.json>; rel="ai-catalog"; type="application/json"
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com https://static.cloudflareinsights.com; frame-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://emo-changeling.xyz https://*.emo-changeling.xyz https://toxic-echo.studio https://*.toxic-echo.studio https://challenges.cloudflare.com; connect-src 'self' https://emo-changeling.xyz https://*.emo-changeling.xyz https://toxic-echo.studio https://*.toxic-echo.studio https://cloudflareinsights.com https://challenges.cloudflare.com; object-src 'none'; base-uri 'self';
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/
  Cache-Control: public, max-age=21600, must-revalidate

/impressum.html
  Cache-Control: public, max-age=21600, must-revalidate

/pl/
  Cache-Control: public, max-age=300, must-revalidate

/pl/*
  Cache-Control: public, max-age=21600, must-revalidate

/en/
  Cache-Control: public, max-age=300, must-revalidate

/en/*
  Cache-Control: public, max-age=21600, must-revalidate

/img/*
  Cache-Control: public, max-age=31536000, immutable, no-transform

/css/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800, no-transform

/sitemap.xml
  Cache-Control: public, max-age=3600, must-revalidate
  Content-Type: application/xml; charset=utf-8

/robots.txt
  Cache-Control: no-cache
  Content-Type: text/plain; charset=utf-8

/humans.txt
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Type: text/plain; charset=utf-8

/llms.txt
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Type: text/plain; charset=utf-8

/ai.json
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Type: application/json; charset=utf-8

/site.webmanifest
  Cache-Control: public, max-age=86400
  Content-Type: application/manifest+json; charset=utf-8

/favicon.svg
  Content-Type: image/svg+xml; charset=utf-8

/.well-known/ai-catalog.json
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Type: application/json; charset=utf-8

/rss*.xml
  Cache-Control: public, max-age=1800, must-revalidate
  Content-Type: application/rss+xml; charset=utf-8
