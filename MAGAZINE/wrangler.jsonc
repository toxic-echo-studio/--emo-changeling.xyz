{
  // Deklaratywna konfiguracja Cloudflare Workers Static Assets - The Reverse Emo Changeling Magazine
  "name": "emo-magazine-gt",
  "compatibility_date": "2026-10-23",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "."
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
      "redact_query_string": true
    }
  }
}
